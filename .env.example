# TMAIL settings. install.sh writes this file (as .env) and generates every password; edit by hand
# only to change something later, then: docker compose up -d
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
# Links to large files (stored in Garage S3)
FILES_HOSTNAME=files.example.com
PUBLIC_IP=203.0.113.10
DKIM_SELECTOR=s2026

# Interface defaults: language (en, ru, de, es, zh-CN …), time zone, country (ISO code)
DEFAULT_LANG=en
DEFAULT_TIMEZONE=UTC
COUNTRY=US
# Name of your organisation: shown on the download pages of large files and in mail profiles
ORG_NAME=Example Ltd

# Secrets (install.sh: openssl rand -hex 24)
DB_PASSWORD=
MTA_DB_PASSWORD=
DOVECOT_MASTER_PASSWORD=
DOVEADM_API_KEY=
GARAGE_RPC_SECRET=
# Filled by deploy/garage-init.sh
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI assistant: any OpenAI-compatible API. Can also be changed in the admin panel (AI assistant).
#   OpenAI:      AI_API_URL=https://api.openai.com      AI_MODEL=gpt-4o-mini
#   OpenRouter:  AI_API_URL=https://openrouter.ai/api   AI_MODEL=openai/gpt-4o-mini
#   own model:   AI_API_URL=http://10.0.0.5:8000        AI_MODEL=<name served by vLLM/Ollama>
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Backups (deploy/backup.sh, restic). Keep a copy of BACKUP_PASSWORD outside the server.
BACKUP_PASSWORD=
# /var/backups/tmail/restic (this server), s3:https://host/bucket, sftp:user@host:/path
BACKUP_REPOSITORY=/var/backups/tmail/restic
# For an S3 backup repository:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
