# Postfix — TMAIL. Settings modelled on mailcow's main.cf, trimmed to what we use.
compatibility_level = 3.6
# myhostname is set by entrypoint.sh from MAIL_HOSTNAME
myorigin = $myhostname
mydestination = localhost
mynetworks = 127.0.0.0/8 [::1]/128
inet_interfaces = all
inet_protocols = all
maillog_file = /dev/stdout
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
smtputf8_enable = yes
recipient_delimiter = +
message_size_limit = 52428800
mailbox_size_limit = 0
maximal_queue_lifetime = 3d
bounce_queue_lifetime = 1d
disable_vrfy_command = yes
strict_rfc821_envelopes = yes
smtpd_helo_required = yes

# --- Virtual domains, mailboxes and aliases come from PostgreSQL (schema "mta") ---
virtual_mailbox_domains = proxy:pgsql:/etc/postfix/pgsql/domains.cf
virtual_mailbox_maps = proxy:pgsql:/etc/postfix/pgsql/mailboxes.cf
virtual_alias_maps = proxy:pgsql:/etc/postfix/pgsql/aliases.cf
smtpd_sender_login_maps = proxy:pgsql:/etc/postfix/pgsql/sender_logins.cf
virtual_transport = lmtp:inet:127.0.0.1:24
proxy_read_maps = $virtual_mailbox_domains $virtual_mailbox_maps $virtual_alias_maps $smtpd_sender_login_maps $local_recipient_maps $mydestination $virtual_alias_domains $relay_domains $canonical_maps $sender_canonical_maps $recipient_canonical_maps $relocated_maps $transport_maps $mynetworks $smtpd_sender_restrictions

# --- SASL via Dovecot (enabled only on submission ports, see master.cf) ---
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:127.0.0.1:12345
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous, noplaintext
smtpd_sasl_tls_security_options = noanonymous
smtpd_sasl_authenticated_header = no

# --- TLS (server) ---
smtpd_tls_cert_file = /etc/zmail/tls/fullchain.pem
smtpd_tls_key_file = /etc/zmail/tls/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_mandatory_ciphers = high
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
tls_preempt_cipherlist = yes

# --- TLS (client, outbound) ---
smtp_tls_security_level = may
smtp_tls_loglevel = 1
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# --- Restrictions for incoming mail on port 25 ---
smtpd_helo_restrictions = permit_mynetworks, reject_invalid_helo_hostname, reject_non_fqdn_helo_hostname
# Nobody may send as one of our own domains without logging in: phishing "from tim@" sent straight
# to port 25 from outside is refused (port 25 has no SASL, so reject_sender_login_mismatch is a no-op here).
smtpd_sender_restrictions = permit_mynetworks, reject_non_fqdn_sender, reject_unknown_sender_domain, check_sender_access proxy:pgsql:/etc/postfix/pgsql/own_sender.cf
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, defer_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, reject_non_fqdn_recipient, reject_unknown_recipient_domain, reject_unauth_destination, reject_unlisted_recipient
smtpd_data_restrictions = reject_unauth_pipelining
# SMTP smuggling (CVE-2023-51764): bare <LF> line endings from outside are refused.
smtpd_forbid_bare_newline = yes
smtpd_forbid_bare_newline_exclusions = $mynetworks
smtpd_forbid_unauth_pipelining = yes

# --- Rate limits against brute force and floods ---
anvil_rate_time_unit = 60s
smtpd_client_connection_rate_limit = 60
smtpd_client_auth_rate_limit = 20
smtpd_client_message_rate_limit = 200

# --- Rspamd (spam filter + DKIM signing) via milter ---
smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = $smtpd_milters
milter_default_action = accept
milter_protocol = 6
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
